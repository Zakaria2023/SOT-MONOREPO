# Copy to apps/mobile/.env and fill in.
# EXPO_PUBLIC_* vars are inlined into the app bundle at build time.

# Base URL of apps/api (the versioned REST API the mobile app talks to).
# Web / iOS simulator can use localhost. A PHYSICAL device (Expo Go) must use
# your computer's LAN IP so the phone can reach your dev machine, e.g.:
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:3002
EXPO_PUBLIC_API_URL=http://localhost:3002

# Clerk publishable key — same value as NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY in the
# repo root .env.local (starts with pk_test_ or pk_live_).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
