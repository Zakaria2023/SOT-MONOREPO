{
  "expo": {
    "name": "SOT",
    "slug": "sot-mobile",
    "scheme": "sotmobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#0b0b0f",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sot.mobile"
    },
    "android": {
      "package": "com.sot.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
